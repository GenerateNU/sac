package layouts

templ Base(title string, styles templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@styles
		</head>
		<body class="antialiased">
			{ children... }
		</body>
	</html>
}
