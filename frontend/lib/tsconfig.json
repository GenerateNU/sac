{
  "compilerOptions": {
      "target": "es5",
      "lib": ["dom", "dom.iterable", "esnext"],
      "allowJs": true,
      "skipLibCheck": true,
      "strict": true,
      "esModuleInterop": true,
      "outDir": "./dist",
      "module": "esnext",
      "moduleResolution": "bundler",
      "declaration": true,
      "emitDeclarationOnly": false,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "preserve",
      "incremental": true,
      "plugins": [
          {
              "name": "next"
          }
      ],
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "./dist/**/*"]
}
