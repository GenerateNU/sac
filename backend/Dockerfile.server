FROM golang:1.22-alpine as builder

WORKDIR /app
RUN apk add --no-cache make nodejs npm git

COPY . ./
RUN go install github.com/a-h/templ/cmd/templ@latest
RUN templ generate
RUN go get ./...
RUN go mod tidy
RUN go mod download
RUN go build -tags prod -o bin/sac main.go

FROM scratch
COPY --from=builder /app/bin/sac /sac

EXPOSE 8080
ENTRYPOINT [ "./sac" ]